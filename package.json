{
  "name": "levelblue-scorecard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "qa": "node tools/report-qa/cli.mjs",
    "qa:test": "node --test tools/report-qa/test.mjs",
    "qa:rules": "node tools/report-qa/cli.mjs --list-rules",
    "qa:build": "node tools/report-qa/build-standalone.mjs",
    "qa:manual": "node tools/report-qa/build-manual.mjs",
    "qa:deck": "npm run qa:build && node tools/report-qa/deck/capture.mjs && node tools/report-qa/deck/build.mjs",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "gh-pages": "^6.3.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^5.4.21"
  }
}
